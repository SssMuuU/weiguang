<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="$(var.ProductName)" Language="2052" Codepage="936" Version="$(var.Version)" Manufacturer="微光" UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" SummaryCodepage="936" />
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="已安装更新版本，请勿降级。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="ExistingMsiLocation" Root="HKCU" Key="Software\Weiguang\Installer" Name="Location" Type="raw" Win64="yes" />
      <RegistrySearch Id="LegacyLocation" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Weiguang" Name="InstallLocation" Type="raw" Win64="yes" />
    </Property>
    <Property Id="WINDOWSBUILD"><RegistrySearch Id="WindowsBuildNumber" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Win64="yes" /></Property>
    <Condition Message="微光需要 Windows 10 或更新系统（64 位）。">Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 10240)</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder"><Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="微光" /></Directory></Directory>
      <Directory Id="ProgramMenuFolder"><Directory Id="AppStartMenu" Name="微光" /></Directory>
      <Directory Id="DesktopFolder" />
    </Directory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="ShellIntegration" Guid="*" Win64="yes">
        <RegistryValue Root="HKCU" Key="Software\Weiguang\Installer" Name="Location" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Weiguang" Action="removeOnInstall" />
        <RemoveFile Id="RemoveLegacyUninstaller" Name="卸载微光.exe" On="install" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="微光" Target="[#AppLauncher]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="MenuShortcut" Directory="AppStartMenu" Name="微光" Target="[#AppLauncher]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveStartMenu" Directory="AppStartMenu" On="uninstall" />
        <RemoveFolder Id="RemoveEmptyUserPrograms" Directory="UserPrograms" On="uninstall" />
      </Component>
    </DirectoryRef>
    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Feature Id="Main" Title="微光" Level="1"><ComponentGroupRef Id="AppFiles" /><ComponentRef Id="ShellIntegration" /></Feature>
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicensePath)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="打开微光" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApp" FileKey="AppLauncher" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <UI><Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish></UI>
  </Product>
</Wix>
